SPARK = "▁▂▃▄▅▆▇█"


def fb(n):
    if n is None:
        return "n/a"
    for unit, d in (("TiB", 2**40), ("GiB", 2**30), ("MiB", 2**20), ("KiB", 2**10)):
        if n >= d:
            v = n / d
            return f"{v:.0f} {unit}" if v >= 100 else f"{v:.1f} {unit}"
    return f"{n:.0f} B"


def fr(n):
    return fb(n) + "/s"


def fv(v, fmt="{:.0f}", unit=""):
    return "n/a" if v is None else fmt.format(v) + unit


def fup(sec):
    d, r = divmod(int(sec), 86400)
    h, r = divmod(r, 3600)
    return (f"{d}d " if d else "") + f"{h}h {r // 60:02d}m"


class UI:
    def __init__(self, scr, nodes, col, interval):
        self.scr, self.nodes, self.col = scr, nodes, col
        self.interval = interval
        self.view = "mesh" if len(nodes) > 1 else "node"
        self.sel = 0          # selected node
        self.sort = 0
        self.help = False
        self.psel, self.cur_procs, self.msg = 0, [], ""
        curses.curs_set(0)
        # NVIDIA theme on dark gray #1E1E1E. Green #76B900 marks the brand and
        # everything GPU, McLaren papaya #FF8000 marks speed (vLLM tokens per
        # second), steel blue marks the CPU, violet marks memory, plain values
        # are white, and yellow and red appear only for warnings.
        self.c = {}
        if curses.COLORS >= 256:
            try:
                if curses.can_change_color():
                    curses.init_color(106, 463, 725, 0)      # exact NVIDIA green #76B900
                    curses.init_color(208, 1000, 502, 0)     # exact McLaren papaya #FF8000
            except curses.error:
                pass
            bg, black = 234, 16                              # 234 = #1C1C1C
            table = {"g": 106, "m": 150, "b": 64, "s": 108, "a": 74, "o": 208,
                     "p": 141, "q": 183, "u": 97, "v": 139, "c": 255, "y": 220, "r": 203, "d": 245, "x": 240}
            curses.init_pair(20, 252, bg)
            scr.bkgd(" ", curses.color_pair(20))
        else:
            curses.use_default_colors()
            bg, black = -1, curses.COLOR_BLACK
            table = {"g": curses.COLOR_GREEN, "m": curses.COLOR_GREEN, "b": curses.COLOR_GREEN, "s": curses.COLOR_GREEN,
                     "a": curses.COLOR_CYAN, "o": curses.COLOR_YELLOW,
                     "p": curses.COLOR_MAGENTA, "q": curses.COLOR_MAGENTA,
                     "u": curses.COLOR_MAGENTA, "v": curses.COLOR_MAGENTA,
                     "c": curses.COLOR_WHITE, "y": curses.COLOR_YELLOW, "r": curses.COLOR_RED,
                     "d": curses.COLOR_WHITE, "x": curses.COLOR_WHITE}
        for i, (name, fg) in enumerate(table.items(), 1):
            curses.init_pair(i, fg, bg)
            self.c[name] = curses.color_pair(i)
        curses.init_pair(21, black, table["g"])
        self.c["hd"] = curses.color_pair(21) | curses.A_BOLD   # header, tabs, selection
        self.c["w"] = curses.A_BOLD
        self.c["n"] = 0
        scr.timeout(250)

    # -- drawing helpers
    def put(self, y, x, text, attr=0):
        if y < 0 or y >= self.H or x >= self.clip or x < 0:
            return
        try:
            self.scr.addstr(y, x, str(text)[:self.clip - x], attr)
        except curses.error:
            pass

    def seq(self, y, x, parts):
        """parts: [(text, color)] in sequence."""
        for text, col in parts:
            self.put(y, x, text, self.c[col] if isinstance(col, str) else col)
            x += len(str(text))
        return x

    def box(self, y, x, h, w, title, extra=""):
        d = self.c["x"]
        self.clip = self.W
        self.put(y, x, "┌" + "─" * (w - 2) + "┐", d)
        for i in range(1, h - 1):
            self.put(y + i, x, "│", d)
            self.put(y + i, x + w - 1, "│", d)
        self.put(y + h - 1, x, "└" + "─" * (w - 2) + "┘", d)
        self.put(y, x + 2, f" {title} ", self.c["hd"])
        if extra:
            self.put(y, x + 4 + len(title), f" {extra} "[:max(0, w - 6 - len(title))], self.c["d"])
        self.clip = min(self.W, x + w - 2)
        return y + 1, x + 2, w - 4

    def pc(self, v, lo=60, hi=85, ok="n"):
        """Color for a value: 'ok' while healthy, amber and red beyond the limits."""
        return ok if v < lo else ("y" if v < hi else "r")

    def bar(self, y, x, w, segs):
        """segs: [(fraction 0..1, color)]"""
        if w <= 0:
            return
        self.put(y, x, "░" * w, self.c["x"])
        pos = 0
        for frac, col in segs:
            n = int(round(max(0.0, min(1.0, frac)) * w))
            n = min(n, w - pos)
            if n > 0:
                self.put(y, x + pos, "█" * n, self.c[col])
                pos += n

    def spark(self, y, x, w, vals, col, top=None):
        if w <= 0:
            return
        vals = list(vals)[-w:]
        top = top or max(vals + [1e-9])
        s = "".join(SPARK[min(7, int(7.999 * max(0, v) / top))] if top > 0 else SPARK[0] for v in vals)
        self.put(y, x, " " * (w - len(s)) + s, self.c[col])

    # -- view: single node
    def draw_node(self, node, y):
        s, W = node.snap, self.W
        if not s:
            self.put(y + 1, 2, f"{node.name}: {node.err or 'no data yet'}", self.c["r"])
            return
        for a in s["alerts"][:3]:
            col = {"crit": "r", "warn": "y"}.get(a["level"], "c")
            self.put(y, 1, "▲ " + a["msg"], self.c[col] | curses.A_BOLD)
            y += 1
        half = W // 2
        cpu, mem, hist = s["cpu"], s["mem"], s["hist"]

        # CPU
        iy, ix, iw = self.box(y, 0, 6, half, "CPU", f"{len(cpu['cores'])} cores")
        self.seq(iy, ix, [(fv(cpu["temp"], "{:.0f}", "°C"), self.pc(cpu["temp"] or 0, 70, 88)), ("  ", "n"),
                          (fv(cpu["freq"] and cpu["freq"] / 1000, "{:.1f}", " GHz"), "n"),
                          ("  load ", "d"), (" ".join(f"{l:.2f}" for l in cpu["load"]), "n"),
                          ("  tasks ", "d"), (cpu["tasks"], "n")])
        self.put(iy + 1, ix, "util", self.c["d"])
        self.bar(iy + 1, ix + 5, iw - 13, [(cpu["util"] / 100, self.pc(cpu["util"], ok="a"))])
        self.put(iy + 1, ix + iw - 7, f"{cpu['util']:5.1f} %", self.c[self.pc(cpu["util"])])
        self.put(iy + 2, ix, "core", self.c["d"])
        for i, u in enumerate(cpu["cores"][:iw - 5]):
            self.put(iy + 2, ix + 5 + i, SPARK[min(7, int(u / 12.5))], self.c[self.pc(u, ok="a")])
        cx = ix + 6 + len(cpu["cores"])
        if cx + 30 < ix + iw:
            self.seq(iy + 2, cx, [(" usr ", "d"), (f"{cpu['usr']:.1f}%", "n"), (" sys ", "d"),
                                  (f"{cpu['sys']:.1f}%", "n"), (" io ", "d"), (f"{cpu['iowait']:.1f}%", "n")])
        self.put(iy + 3, ix, "hist", self.c["d"])
        self.spark(iy + 3, ix + 5, iw - 5, hist["cpu"], "a", 100)

        # memory
        title = "Memory · shared with GPU" if s["unified"] else "Memory"
        iy, ix, iw = self.box(y, half, 6, W - half, title)
        tot = max(1, mem["total"])
        gpum = min(s["gpu_proc_mem"], mem["used"]) if s["unified"] else 0
        upct = 100.0 * mem["used"] / tot
        self.seq(iy, ix, [("RAM ", "d"), (f"{fb(mem['used'])} / {fb(mem['total'])}", "w"),
                          ("  avail ", "d"), (fb(mem["avail"]), self.pc(upct, 80, 92)),
                          ("  Swap ", "d"), (f"{fb(mem['swap_used'])} / {fb(mem['swap_total'])}", "n")])
        syscol = "d" if s["unified"] else "p"
        # memory is violet: the biggest GPU process gets the main tone, the rest rotate through its shades
        ranked = sorted(s["procs"], key=lambda p: (-p["gpu_mem"], p["pid"]))
        pcol = {p["pid"]: "p" if i == 0 else "quv"[(i - 1) % 3] for i, p in enumerate(ranked)}
        segs = [(p["gpu_mem"] / tot, pcol[p["pid"]])
                for p in sorted(s["procs"], key=lambda p: -p["gpu_mem"])] if s["unified"] else []
        self.bar(iy + 1, ix, iw - 8, segs + [((mem["used"] - gpum) / tot, syscol)])
        self.put(iy + 1, ix + iw - 7, f"{upct:5.1f} %", self.c[self.pc(upct, 80, 92)])
        parts = []
        if s["unified"]:
            parts += [("■", "p"), ("■ ", "q"), (f"GPU {fb(gpum)}  ", "n")]
        parts += [("■ ", syscol), (f"system {fb(mem['used'] - gpum)}  ", "n"),
                  ("Cache ", "d"), (fb(mem["cache"]), "n")]
        if mem["psi"] is not None:
            parts += [("  pressure ", "d"), (f"{mem['psi']:.1f}%", self.pc(mem["psi"], 5, 20))]
        self.seq(iy + 2, ix, parts)
        self.put(iy + 3, ix, "hist", self.c["d"])
        self.spark(iy + 3, ix + 5, iw - 5, hist["mem"], "u", 100)
        y += 6

        # GPU
        gpus = s["gpus"]
        gh = 2 + max(1, 2 * len(gpus)) + 1
        iy, ix, iw = self.box(y, 0, gh, W, "GPU", f"driver {s['driver']} · {s['gpu_src']}")
        if not gpus:
            self.put(iy, ix, "no NVIDIA GPU found " + s.get("gpu_error", ""), self.c["d"])
        for i, g in enumerate(gpus):
            r = iy + 2 * i
            x = self.seq(r, ix, [(f"GPU {i} ", "c"), (g["name"], "w"), ("  ", "n"),
                                 (fv(g["temp"], "{:.0f}", "°C"), self.pc(g["temp"] or 0, 75, 88)),
                                 ("  ⚡ ", "g"), (fv(g["power"], "{:.1f}", " W"), "n"),
                                 ("  ", "n"), (fv(g["clock"], "{:.0f}", " MHz"), "n")])
            if g["mem_total"]:
                self.seq(r, x, [("  VRAM ", "d"), (f"{fb(g['mem_used'])} / {fb(g['mem_total'])}", "n")])
            else:
                self.seq(r, x, [("  memory ", "d"), (fb(s["gpu_proc_mem"]), "n"), (" (sum of processes)", "d")])
            u = g["util"] or 0
            self.put(r + 1, ix, "util", self.c["d"])
            self.bar(r + 1, ix + 5, iw - 13, [(u / 100, "g")])
            self.put(r + 1, ix + iw - 7, fv(g["util"], "{:5.1f}", " %"), self.c["g"])
        r = iy + max(1, 2 * len(gpus))
        hw = (iw - 14) // 2
        self.put(r, ix, "util", self.c["d"])
        self.spark(r, ix + 5, hw, hist["gpu"], "g", 100)
        self.put(r, ix + 7 + hw, "watt", self.c["d"])
        self.spark(r, ix + 12 + hw, hw, hist["power"], "b", max(hist["power"][-max(1, hw):] + [60]))
        y += gh

        # vLLM
        vl = s["vllm"]
        live = [v for v in vl if v["ok"]]
        vh = 2 + (len(live) + 1 if live else 1)
        iy, ix, iw = self.box(y, 0, vh, W, "vLLM")
        if not live:
            self.put(iy, ix, "no vLLM reachable (" + ", ".join(
                urlparse(v["url"]).netloc for v in vl) + ") - panel fills in once /metrics responds", self.c["d"])
        for i, v in enumerate(live):
            model = ", ".join(v["models"]) or "?"
            if len(model) > 34:
                model = "…" + model[-33:]
            self.seq(iy + i, ix, [
                ("● ", "g"), (f":{urlparse(v['url']).port} ", "c"), (f"{model:<34} ", "w"),
                ("running ", "d"), (f"{v['running']:<3.0f}", "n"),
                ("waiting ", "d"), (f"{v['waiting']:<3.0f}", "y" if v["waiting"] else "n"),
                ("gen ", "d"), (f"{v['gen_tps']:7.1f} tok/s  ", "o"),
                ("prompt ", "d"), (f"{v['prompt_tps']:7.1f} tok/s  ", "n"),
                ("TTFT ", "d"), (fv(v["ttft"] and v["ttft"] * 1000, "{:.0f}", " ms") + "  ", "n"),
                ("E2E ", "d"), (fv(v["e2e"], "{:.1f}", " s") + "  ", "n"),
                ("KV-Cache ", "d"), (fv(v["kv"], "{:.0f}", " %"), self.pc(v["kv"] or 0, 70, 90))])
        if live:
            top = max(hist["tps"][-(iw - 22):] + [1])
            self.put(iy + len(live), ix, "tok/s", self.c["d"])
            self.spark(iy + len(live), ix + 6, iw - 22, hist["tps"], "o")
            self.put(iy + len(live), ix + iw - 14, f"max {top:.0f}", self.c["d"])
        y += vh

        # disk + network
        disks, fs, nets = s["disks"], s["fs"], s["net"]
        rows = max(1, min(4, max(len(disks) + len(fs), len(nets))))
        dh = rows + 3
        iy, ix, iw = self.box(y, 0, dh, half, "Disk")
        self.put(iy, ix, f"{'Device':<14}{'used':>18}{'Read':>13}{'Write':>13}", self.c["d"])
        r = iy + 1
        for f in fs[:rows]:
            p = 100.0 * f["used"] / f["total"]
            self.seq(r, ix, [(f"{f['mount'][:13]:<14}", "n"),
                             (f"{fb(f['used']):>9}/{fb(f['total']):<8}", "n"), (f"{p:3.0f}%", self.pc(p, 80, 92))])
            r += 1
        for d in disks[:max(0, rows - len(fs[:rows]))]:
            self.seq(r, ix, [(f"{d['dev'][:13]:<14}", "c"), (" " * 18, "n"),
                             (f"{fr(d['read']):>13}", "n"), (f"{fr(d['write']):>13}", "n")])
            r += 1
        iy, ix, iw = self.box(y, half, dh, W - half, "Network")
        self.put(iy, ix, f"{'Interface':<18}{'Link':>10}{'RX':>13}{'TX':>13}{'Errors':>8}", self.c["d"])
        for i, n in enumerate(nets[:rows]):
            up = n["state"] == "up"
            link = (f"{n['speed'] / 1000:g} Gb" if n["speed"] and n["speed"] >= 1000
                    else f"{n['speed']} Mb" if n["speed"] else n["state"])
            self.seq(iy + 1 + i, ix, [("● " if up else "○ ", "g" if up else "d"),
                                      (f"{n['if'][:15]:<16}", "n" if up else "d"), (f"{link:>10}", "n" if up else "d"),
                                      (f"{fr(n['rx']):>13}", "n" if up else "d"), (f"{fr(n['tx']):>13}", "n" if up else "d"),
                                      (f"{n['err'] + n['drop']:>8}", "r" if n.get("err_new") else "d")])
        y += dh

        # processes
        keys = [("GPU memory", "gpu_mem"), ("CPU", "cpu"), ("RAM", "rss")]
        procs = sorted(s["procs"], key=lambda p: -p[keys[self.sort][1]])
        ph = max(4, self.H - y - 1)
        iy, ix, iw = self.box(y, 0, ph, W, "GPU processes", f"{len(procs)} · sorted by {keys[self.sort][0]}")
        self.put(iy, ix, f"{'PID':>8} {'USER':<10}{'TYPE':<4}{'CPU%':>7}{'GPU-MEM':>10}{'RAM':>10}  NAME", self.c["d"])
        if not procs:
            self.put(iy + 1, ix, "no processes on the GPU", self.c["d"])
        self.cur_procs = procs if node is self.nodes[0] else []
        self.psel = max(0, min(self.psel, len(procs) - 1))
        for i, p in enumerate(procs[:ph - 3]):
            x = self.seq(iy + 1 + i, ix, [
                (f"{p['pid']:>8} ", self.c["hd"] if i == self.psel else "n"), (f"{p['user'][:9]:<10}", "n"),
                (f"{p['type']:<4}", "g" if p["type"] == "C" else "d"),
                (f"{p['cpu']:>6.1f}%", self.pc(p["cpu"], 150, 600)),
                (f"{fb(p['gpu_mem']):>10}", "n"), (f"{fb(p['rss']):>10}", "n"), ("  ", "n"), ("■ ", pcol[p["pid"]])])
            if p["container"]:
                x = self.seq(iy + 1 + i, x, [("[" + p["container"][:28] + "] ", "c")])
            self.put(iy + 1 + i, x, p["name"][:max(0, ix + iw - x)])

    # -- view: mesh
    def draw_mesh(self, y):
        W = self.W
        iy, ix, iw = self.box(y, 0, len(self.nodes) + 5, W, "Mesh", f"{len(self.nodes)} node" + ("s" if len(self.nodes) != 1 else ""))
        self.put(iy, ix, f"  {'Node':<26}{'Latency':>8}{'CPU':>7}{'RAM':>20}{'GPU':>7}{'Temp':>7}"
                         f"{'Power':>8}{'tok/s':>9}{'run/wait':>12}{'Net RX/TX':>24}  Alerts", self.c["d"])
        tot = collections.Counter()
        for i, n in enumerate(self.nodes):
            r, s = iy + 1 + i, n.snap
            selattr = self.c["hd"] if i == self.sel else curses.A_BOLD
            stale = not n.ok or not s
            self.put(r, ix, ("● " if not stale else "○ "), self.c["g" if not stale else "r"])
            self.put(r, ix + 2, f"{n.name[:25]:<26}", selattr)
            if not s:
                self.put(r, ix + 29, n.err or "no data", self.c["r"])
                continue
            gp = s["gpus"]
            util = [g["util"] for g in gp if g["util"] is not None]
            gu = sum(util) / len(util) if util else None
            temp = max([g["temp"] for g in gp if g["temp"] is not None], default=None)
            watt = sum(g["power"] or 0 for g in gp)
            live = [v for v in s["vllm"] if v["ok"]]
            tps = sum(v["gen_tps"] for v in live)
            run, wait = sum(v["running"] for v in live), sum(v["waiting"] for v in live)
            rx, tx = sum(x["rx"] for x in s["net"]), sum(x["tx"] for x in s["net"])
            m = s["mem"]
            mp = 100.0 * m["used"] / max(1, m["total"])
            col = (lambda c: "d") if stale else (lambda c: c)
            self.seq(r, ix + 28, [
                (f"{fv(n.lat, '{:.0f}', ' ms'):>8}", col("n")),
                (f"{s['cpu']['util']:>6.0f}%", col(self.pc(s["cpu"]["util"]))),
                (f"{fb(m['used']) + ' / ' + fb(m['total']):>20}", col(self.pc(mp, 80, 92))),
                (f"{fv(gu, '{:.0f}', '%'):>7}", col("g")),
                (f"{fv(temp, '{:.0f}', '°C'):>7}", col(self.pc(temp or 0, 75, 88))),
                (f"{watt:>6.1f} W", col("n")),
                (f"{tps:>9.1f}", col("o")),
                (f"{run:>7.0f}/{wait:<4.0f}", col("y" if wait else "n")),
                (f"{fr(rx) + ' / ' + fr(tx):>24}", col("n")), ("  ", "n"),
                (str(len(s["alerts"])) if s["alerts"] else "-", col("r" if s["alerts"] else "d")),
                (f"  {n.err}" if stale else "", "r")])
            if not stale:
                tot.update(watt=watt, tps=tps, run=run, wait=wait, used=m["used"], total=m["total"],
                           gmem=s["gpu_proc_mem"], n=1)
        r = iy + 1 + len(self.nodes)
        self.put(r, ix, "─" * iw, self.c["d"])
        self.seq(r + 1, ix + 2, [(f"Total ({tot['n']} online)  ", "w"),
                                 ("RAM ", "d"), (f"{fb(tot['used'])} / {fb(tot['total'])}  ", "n"),
                                 ("GPU processes ", "d"), (f"{fb(tot['gmem'])}  ", "n"),
                                 ("Power ", "d"), (f"{tot['watt']:.1f} W  ", "n"),
                                 ("vLLM ", "d"), (f"{tot['tps']:.1f} tok/s  ", "o"),
                                 ("running/waiting ", "d"), (f"{tot['run']:.0f}/{tot['wait']:.0f}", "n")])
        y += len(self.nodes) + 5
        # history per node
        iy, ix, iw = self.box(y, 0, len(self.nodes) + 2, W, "History", "GPU utilization · tok/s")
        hw = (iw - 40) // 2
        for i, n in enumerate(self.nodes):
            self.put(iy + i, ix, f"{n.name[:25]:<26}")
            if n.snap:
                self.put(iy + i, ix + 27, "GPU", self.c["d"])
                self.spark(iy + i, ix + 31, hw, n.snap["hist"]["gpu"], "g", 100)
                self.put(iy + i, ix + 33 + hw, "tok/s", self.c["d"])
                self.spark(iy + i, ix + 39 + hw, hw, n.snap["hist"]["tps"], "o")
        y += len(self.nodes) + 2
        # alerts of all nodes
        al = [(n.name, a) for n in self.nodes if n.snap and n.ok for a in n.snap["alerts"]]
        al += [(n.name, {"level": "crit", "msg": "unreachable: " + n.err}) for n in self.nodes if not n.ok]
        if al and y + 3 < self.H:
            iy, ix, iw = self.box(y, 0, min(len(al), self.H - y - 3) + 2, W, "Alerts")
            for i, (name, a) in enumerate(al[:self.H - y - 3]):
                col = {"crit": "r", "warn": "y"}.get(a["level"], "c")
                self.seq(iy + i, ix, [("▲ ", col), (f"{name[:25]:<26}", "w"), (a["msg"], col)])

    def draw_help(self):
        lines = ["gbtop " + VERSION, "",
                 "1 / 2 / Tab node view <-> mesh view",
                 "j k / ↑ ↓   mesh: select node, Enter opens it · node: select process",
                 "K           terminate selected process (SIGTERM, asks first, local only)",
                 "s           cycle process sort order (GPU memory, CPU, RAM)",
                 "+ / -       sampling interval of the local collector",
                 "? / h       this help              q      quit", "",
                 "Mesh is agentless: gbtop --nodes hostA,user@hostB  (key-based SSH and",
                 "python3 on the nodes) or list the nodes in ~/.config/gbtop/nodes."]
        w = max(len(l) for l in lines) + 6
        y0, x0 = max(1, (self.H - len(lines) - 2) // 2), max(0, (self.W - w) // 2)
        self.clip = self.W
        for i in range(len(lines) + 2):
            self.put(y0 + i, x0, " " * w)
        iy, ix, _ = self.box(y0, x0, len(lines) + 2, w, "Help")
        for i, l in enumerate(lines):
            self.put(iy + i, ix + 1, l)

    def draw(self):
        self.H, self.W = self.scr.getmaxyx()
        self.clip = self.W
        self.scr.erase()
        node = self.nodes[self.sel]
        s = node.snap
        x = self.seq(0, 0, [(" gbtop ", self.c["hd"]), (" ", "n")])
        for key, name, v in (("1", "Node", "node"), ("2", "Mesh", "mesh")):
            x = self.seq(0, x, [(f" {key} {name} ", self.c["hd"] if self.view == v else self.c["d"])])
        right = time.strftime("%H:%M:%S")
        if s and self.view == "node":
            right = f"{node.name} · {s['kernel']} · up {fup(s['uptime'])} · {right}"
        self.put(0, max(x + 1, self.W - len(right) - 1), right, self.c["c"])
        top = 1
        if self.W < 110 or self.H < 24:
            self.put(1, 1, f"small terminal ({self.W}x{self.H}) - works best from 130x40", self.c["y"])
            top = 2
        if self.view == "mesh":
            self.draw_mesh(top)
        else:
            self.draw_node(node, top)
        self.clip = self.W
        foot = f" q quit · 1/2/Tab view · j/k select · s sort · K terminate · +/- interval {self.col.interval:g} s · ? help "
        room = self.W - len(SIGNATURE) - 3           # the signature always stays visible
        self.put(self.H - 1, 0, " " * (self.W - 1))
        self.put(self.H - 1, 0, foot[:max(0, room)], self.c["d"])
        if self.msg:
            self.put(self.H - 1, max(0, min(len(foot), room - len(self.msg) - 2)), " " + self.msg + " ", self.c["y"])
        self.put(self.H - 1, max(0, self.W - len(SIGNATURE) - 2), SIGNATURE, self.c["g"])
        if self.help:
            self.draw_help()
        self.scr.refresh()

    def kill(self):
        if not self.cur_procs:
            self.msg = "only processes of the local node can be terminated"
            return
        p = self.cur_procs[min(self.psel, len(self.cur_procs) - 1)]
        self.put(self.H - 1, 0, f" send SIGTERM to PID {p['pid']} ({p['name'][:40]})? y/n ".ljust(self.W - 1),
                 self.c["r"] | curses.A_REVERSE)
        self.scr.refresh()
        self.scr.timeout(-1)
        k = self.scr.getch()
        self.scr.timeout(250)
        if k == ord("y"):
            try:
                os.kill(p["pid"], signal.SIGTERM)
                self.msg = f"SIGTERM sent to PID {p['pid']}"
            except OSError as ex:
                self.msg = f"PID {p['pid']}: {ex.strerror}"

    def loop(self):
        while True:
            self.draw()
            k = self.scr.getch()
            if k == -1:
                continue
            if self.help:
                self.help = False
                continue
            if k in (ord("q"), 27):
                return
            if k in (ord("?"), ord("h")):
                self.help = True
            elif k == ord("1"):
                self.view = "node"
            elif k == ord("2"):
                self.view = "mesh"
            elif k == 9:
                self.view = "mesh" if self.view == "node" else "node"
            elif k in (ord("j"), curses.KEY_DOWN):
                if self.view == "mesh":
                    self.sel = (self.sel + 1) % len(self.nodes)
                else:
                    self.psel += 1
            elif k in (ord("k"), curses.KEY_UP):
                if self.view == "mesh":
                    self.sel = (self.sel - 1) % len(self.nodes)
                else:
                    self.psel = max(0, self.psel - 1)
            elif k == ord("K") and self.view == "node":
                self.kill()
            elif k in (10, 13, curses.KEY_ENTER):
                self.view = "node"
            elif k == ord("s"):
                self.sort = (self.sort + 1) % 3
            elif k in (ord("+"), ord("=")):
                self.col.interval = min(10.0, self.col.interval + 0.5)
            elif k == ord("-"):
                self.col.interval = max(0.5, self.col.interval - 0.5)


# ───────────────────────────── Start ──────────────────────────────────────────

def main():
    ap = argparse.ArgumentParser(prog="gbtop", epilog=SIGNATURE, description="gbtop - monitor for GB10 / DGX Spark with vLLM and mesh")
    ap.add_argument("-i", "--interval", type=float, default=2.0, help="sampling interval in seconds (default 2)")
    ap.add_argument("--vllm", default="http://127.0.0.1:8000",
                    help="vLLM base URLs, comma separated (default http://127.0.0.1:8000)")
    ap.add_argument("--nodes", default="",
                    help="mesh nodes, comma separated: SSH targets (host, user@host, ssh-config alias); "
                         "http://host:port for a node running --serve")
    ap.add_argument("--emit", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--token", default=os.environ.get("GBTOP_TOKEN"), help="token for --serve and for http:// nodes")
    ap.add_argument("--serve", action="store_true", help="run headless: HTTP endpoint with /api/snapshot and Prometheus /metrics")
    ap.add_argument("--bind", default="127.0.0.1", help="bind address for --serve (default 127.0.0.1)")
    ap.add_argument("--port", type=int, default=DEFAULT_PORT)
    ap.add_argument("--no-nvml", action="store_true", help="use nvidia-smi instead of the NVML library")
    ap.add_argument("--once", action="store_true", help="print one snapshot as JSON")
    ap.add_argument("--version", action="version", version=VERSION)
    a = ap.parse_args()

    col = Collector(max(0.5, a.interval), [u.strip() for u in a.vllm.split(",") if u.strip()],
                    use_nvml=not a.no_nvml, persist=not a.once)
    if a.emit:                                   # remote side of an SSH mesh connection
        col.persist = False
        col.sample()
        time.sleep(0.5)
        try:
            while True:
                t0 = time.time()
                sys.stdout.write(json.dumps(col.sample()) + "\n")
                sys.stdout.flush()
                time.sleep(max(0.2, col.interval - (time.time() - t0)))
        except (OSError, KeyboardInterrupt):
            os._exit(0)                              # viewer went away
    if a.once:
        col.sample()
        time.sleep(1.0)
        s = col.sample()
        s.pop("hist")
        print(json.dumps(s, indent=1, ensure_ascii=False))
        return
    threading.Thread(target=col.run, daemon=True).start()

    if a.serve:
        srv = serve(col, a.bind, a.port, a.token)
        print(f"gbtop agent {VERSION} on http://{a.bind}:{a.port}  (GPU source: {col.gpu_src}"
              f"{', token enabled' if a.token else ', no token'})", flush=True)
        signal.signal(signal.SIGTERM, lambda *_: (_ for _ in ()).throw(KeyboardInterrupt()))
        try:
            srv.serve_forever()
        except KeyboardInterrupt:
            pass
        col.save_hist()
        return

    specs = [n.strip() for n in a.nodes.split(",") if n.strip()]
    for line in (read(NODES_FILE) or "").splitlines():
        line = line.split("#")[0].strip()
        if line:
            specs.append(line)
    stop = col.stop
    nodes = [Local(col)]
    for sp in specs:
        if sp.startswith(("http://", "https://")):   # optional: node running "gbtop --serve"
            if a.token and len(sp.split()) == 1:
                sp += " " + a.token
            nodes.append(Remote(sp, max(1.0, a.interval), stop))
        else:
            extra = "--vllm " + shlex.quote(a.vllm) + (" --no-nvml" if a.no_nvml else "")
            nodes.append(SSHNode(sp, max(1.0, a.interval), stop, extra))
    locale.setlocale(locale.LC_ALL, "")
    while col.snap is None:
        time.sleep(0.05)
    try:
        curses.wrapper(lambda scr: UI(scr, nodes, col, a.interval).loop())
    except KeyboardInterrupt:
        pass
    finally:
        stop.set()
        for n in nodes:
            if hasattr(n, "close"):
                n.close()
        col.save_hist()


if __name__ == "__main__":
    main()
