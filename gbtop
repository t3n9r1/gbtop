#!/usr/bin/env python3
"""gbtop - terminal monitor for NVIDIA GB10 (DGX Spark, Dell Pro Max GB10) with
vLLM metrics and a mesh view. Python standard library only, single file.

  gbtop                           local view
  gbtop --nodes hostA,user@hostB  local view plus mesh nodes, agentless over SSH
  gbtop --once                    one snapshot as JSON (for debugging)
  gbtop --serve                   optional HTTP endpoint with Prometheus /metrics

Mesh nodes need nothing installed except python3 and key-based SSH access:
gbtop pipes itself through "ssh host python3 -" and reads the node's data
from that connection. Install: sudo install -m 755 gbtop /usr/local/bin/gbtop
"""
import argparse, collections, ctypes, curses, hmac, json, locale, os, pwd, re
import shlex, signal, socket, subprocess, sys, threading, time
import urllib.request, xml.etree.ElementTree as ET
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs

VERSION = "0.3.0"
SIGNATURE = "irgNET - Hakki Cemre Guenay / https://irg-net.com"
DEFAULT_PORT = 9755
HIST_LEN = 300
HIST_FILE = os.path.expanduser("~/.cache/gbtop/history.json")
NODES_FILE = os.path.expanduser("~/.config/gbtop/nodes")
CLK_TCK = os.sysconf("SC_CLK_TCK")
PAGE = os.sysconf("SC_PAGE_SIZE")
NO_PROXY = urllib.request.build_opener(urllib.request.ProxyHandler({}))


def read(path, default=None):
    try:
        with open(path, "rb") as f:
            return f.read().decode("utf-8", "replace")
    except OSError:
        return default


def num(text):
    """'33 C' -> 33.0, 'N/A' -> None"""
    m = re.match(r"\s*(-?\d+(?:\.\d+)?)", text or "")
    return float(m.group(1)) if m else None


def http_get(url, timeout=1.5, token=None):
    req = urllib.request.Request(url)
    if token:
        req.add_header("Authorization", "Bearer " + token)
    with NO_PROXY.open(req, timeout=timeout) as r:
        return r.read().decode("utf-8", "replace")


# ───────────────────────────── GPU: NVML directly, else nvidia-smi ─────────────

class _Util(ctypes.Structure):
    _fields_ = [("gpu", ctypes.c_uint), ("memory", ctypes.c_uint)]


class _Mem(ctypes.Structure):
    _fields_ = [("total", ctypes.c_ulonglong), ("free", ctypes.c_ulonglong),
                ("used", ctypes.c_ulonglong)]


class _Proc(ctypes.Structure):
    _fields_ = [("pid", ctypes.c_uint), ("mem", ctypes.c_ulonglong),
                ("gi", ctypes.c_uint), ("ci", ctypes.c_uint)]


class Nvml:
    """Minimal NVML binding via ctypes (no nvidia-smi call every second)."""
    NA = 0xFFFFFFFFFFFFFFFF

    def __init__(self):
        L = self.L = ctypes.CDLL("libnvidia-ml.so.1")
        vp, u, P = ctypes.c_void_p, ctypes.c_uint, ctypes.POINTER
        sig = {
            "nvmlInit_v2": [],
            "nvmlDeviceGetCount_v2": [P(u)],
            "nvmlDeviceGetHandleByIndex_v2": [u, P(vp)],
            "nvmlDeviceGetName": [vp, ctypes.c_char_p, u],
            "nvmlSystemGetDriverVersion": [ctypes.c_char_p, u],
            "nvmlDeviceGetTemperature": [vp, ctypes.c_int, P(u)],
            "nvmlDeviceGetPowerUsage": [vp, P(u)],
            "nvmlDeviceGetUtilizationRates": [vp, P(_Util)],
            "nvmlDeviceGetClockInfo": [vp, ctypes.c_int, P(u)],
            "nvmlDeviceGetMemoryInfo": [vp, P(_Mem)],
            "nvmlDeviceGetComputeRunningProcesses_v3": [vp, P(u), P(_Proc)],
            "nvmlDeviceGetGraphicsRunningProcesses_v3": [vp, P(u), P(_Proc)],
        }
        for name, args in sig.items():
            fn = getattr(L, name)
            fn.argtypes, fn.restype = args, ctypes.c_int
        if L.nvmlInit_v2() != 0:
            raise OSError("nvmlInit failed")
        n = u(0)
        if L.nvmlDeviceGetCount_v2(ctypes.byref(n)) != 0:
            raise OSError("nvmlDeviceGetCount failed")
        self.handles = []
        for i in range(n.value):
            h = vp()
            if L.nvmlDeviceGetHandleByIndex_v2(i, ctypes.byref(h)) == 0:
                self.handles.append(h)
        buf = ctypes.create_string_buffer(96)
        self.driver = buf.value.decode() if L.nvmlSystemGetDriverVersion(buf, 96) == 0 else "?"

    def _uint(self, fn, h, *pre):
        v = ctypes.c_uint(0)
        return v.value if fn(h, *pre, ctypes.byref(v)) == 0 else None

    def _procs(self, fn, h, typ, gi):
        n = ctypes.c_uint(0)
        rc = fn(h, ctypes.byref(n), None)
        if rc not in (0, 7) or n.value == 0:      # 7 = INSUFFICIENT_SIZE
            return []
        n = ctypes.c_uint(n.value + 16)
        arr = (_Proc * n.value)()
        if fn(h, ctypes.byref(n), arr) != 0:
            return []
        return [{"pid": arr[i].pid, "type": typ, "gpu": gi,
                 "gpu_mem": None if arr[i].mem == self.NA else arr[i].mem}
                for i in range(n.value)]

    def sample(self):
        L, gpus, procs = self.L, [], []
        for gi, h in enumerate(self.handles):
            buf = ctypes.create_string_buffer(96)
            name = buf.value.decode() if L.nvmlDeviceGetName(h, buf, 96) == 0 else "GPU"
            util, mem = _Util(), _Mem()
            u_ok = L.nvmlDeviceGetUtilizationRates(h, ctypes.byref(util)) == 0
            m_ok = L.nvmlDeviceGetMemoryInfo(h, ctypes.byref(mem)) == 0 and mem.total > 0
            pw = self._uint(L.nvmlDeviceGetPowerUsage, h)
            gpus.append({
                "name": name, "util": float(util.gpu) if u_ok else None,
                "temp": self._uint(L.nvmlDeviceGetTemperature, h, 0),
                "power": pw / 1000.0 if pw is not None else None,
                "clock": self._uint(L.nvmlDeviceGetClockInfo, h, 0),
                "mem_total": mem.total if m_ok else None,
                "mem_used": mem.used if m_ok else None})
            procs += self._procs(L.nvmlDeviceGetComputeRunningProcesses_v3, h, "C", gi)
            procs += self._procs(L.nvmlDeviceGetGraphicsRunningProcesses_v3, h, "G", gi)
        return gpus, procs, self.driver


def smi_sample():
    """Fallback: parse nvidia-smi -q -x."""
    out = subprocess.run(["nvidia-smi", "-q", "-x"], capture_output=True, text=True,
                         timeout=8).stdout
    root = ET.fromstring(out)
    gpus, procs = [], []

    def first(node, *tags):
        for t in tags:
            e = node.find(".//" + t)
            if e is not None and num(e.text) is not None:
                return num(e.text)
        return None

    for gi, g in enumerate(root.findall("gpu")):
        tot = first(g, "fb_memory_usage/total")
        used = first(g, "fb_memory_usage/used")
        gpus.append({
            "name": (g.findtext("product_name") or "GPU").strip(),
            "util": first(g, "utilization/gpu_util"),
            "temp": first(g, "temperature/gpu_temp"),
            "power": first(g, "instant_power_draw", "power_draw", "average_power_draw"),
            "clock": first(g, "clocks/graphics_clock"),
            "mem_total": int(tot * 2**20) if tot else None,
            "mem_used": int(used * 2**20) if tot and used is not None else None})
        for p in g.findall(".//process_info"):
            pid, mem = num(p.findtext("pid")), num(p.findtext("used_memory"))
            if pid is not None:
                procs.append({"pid": int(pid), "type": (p.findtext("type") or "?").strip(),
                              "gpu": gi, "gpu_mem": int(mem * 2**20) if mem is not None else None})
    return gpus, procs, (root.findtext("driver_version") or "?").strip()


# ───────────────────────────── Collector ────────────────────────────────────────

class Collector:
    def __init__(self, interval=2.0, vllm_urls=None, use_nvml=True, persist=False):
        self.interval = interval
        self.vllm_urls = vllm_urls or ["http://127.0.0.1:8000"]
        self.persist = persist
        self.host = socket.gethostname()
        self.nvml = None
        self.gpu_src = "-"
        if use_nvml:
            try:
                self.nvml = Nvml()
                self.gpu_src = "nvml"
            except Exception:
                self.nvml = None
        self.prev = {}
        self.neterr = {}
        self.pcpu = {}
        self.vprev = {}
        self.docker = ({}, 0.0)
        self.hist = {k: collections.deque(maxlen=HIST_LEN)
                     for k in ("cpu", "mem", "gpu", "power", "tps")}
        if persist:
            self._load_hist()
        self.snap = None
        self.saved = time.time()
        self.stop = threading.Event()

    # -- history across restarts
    def _load_hist(self):
        try:
            d = json.loads(read(HIST_FILE) or "")
            if time.time() - d["ts"] < 3600 and d.get("host") == self.host:
                for k in self.hist:
                    self.hist[k].extend(d["hist"].get(k, []))
        except Exception:
            pass

    def save_hist(self):
        if not self.persist:
            return
        self.saved = time.time()
        try:
            os.makedirs(os.path.dirname(HIST_FILE), exist_ok=True)
            with open(HIST_FILE, "w") as f:
                json.dump({"ts": time.time(), "host": self.host,
                           "hist": {k: list(v) for k, v in self.hist.items()}}, f)
        except OSError:
            pass

    def _rate(self, key, value, now):
        old = self.prev.get(key)
        self.prev[key] = (value, now)
        if not old or now <= old[1] or value < old[0]:
            return 0.0
        return (value - old[0]) / (now - old[1])

    # -- CPU
    def cpu(self, now):
        cores, tot = [], {}
        for line in (read("/proc/stat") or "").splitlines():
            if not line.startswith("cpu"):
                continue
            p = line.split()
            v = [int(x) for x in p[1:9]]
            total, idle = sum(v), v[3] + v[4]
            old = self.prev.get("c" + p[0])
            self.prev["c" + p[0]] = (v, total)
            if old and total > old[1]:
                dt = total - old[1]
                d = [a - b for a, b in zip(v, old[0])]
                util = 100.0 * (1 - (d[3] + d[4]) / dt)
                if p[0] == "cpu":
                    tot = {"util": util, "usr": 100.0 * (d[0] + d[1]) / dt,
                           "sys": 100.0 * (d[2] + d[5] + d[6]) / dt,
                           "iowait": 100.0 * d[4] / dt}
                else:
                    cores.append(round(util, 1))
            elif p[0] != "cpu":
                cores.append(0.0)
        la = (read("/proc/loadavg") or "0 0 0 0/0").split()
        freqs = []
        for i in range(len(cores)):
            f = read(f"/sys/devices/system/cpu/cpu{i}/cpufreq/scaling_cur_freq")
            if f:
                freqs.append(int(f) / 1000.0)
        return {"util": tot.get("util", 0.0), "usr": tot.get("usr", 0.0),
                "sys": tot.get("sys", 0.0), "iowait": tot.get("iowait", 0.0),
                "cores": cores, "load": [float(x) for x in la[:3]],
                "tasks": la[3] if len(la) > 3 else "",
                "freq": sum(freqs) / len(freqs) if freqs else None,
                "freq_max": max(freqs) if freqs else None}

    # -- memory
    def mem(self):
        m = {}
        for line in (read("/proc/meminfo") or "").splitlines():
            k, _, v = line.partition(":")
            m[k] = int(v.split()[0]) * 1024
        psi = None
        t = read("/proc/pressure/memory")
        if t:
            mm = re.search(r"some avg10=([\d.]+)", t)
            psi = float(mm.group(1)) if mm else None
        total, avail = m.get("MemTotal", 0), m.get("MemAvailable", 0)
        return {"total": total, "avail": avail, "used": total - avail,
                "cache": m.get("Cached", 0) + m.get("SReclaimable", 0),
                "buf": m.get("Buffers", 0), "swap_total": m.get("SwapTotal", 0),
                "swap_used": m.get("SwapTotal", 0) - m.get("SwapFree", 0), "psi": psi}

    # -- temperatures
    def temps(self):
        out = {}
        base = "/sys/class/hwmon"
        try:
            mons = sorted(os.listdir(base))
        except OSError:
            return out
        for h in mons:
            name = (read(f"{base}/{h}/name") or h).strip()
            try:
                files = os.listdir(f"{base}/{h}")
            except OSError:
                continue
            for f in sorted(files):
                m = re.match(r"temp(\d+)_input$", f)
                if not m:
                    continue
                v = num(read(f"{base}/{h}/{f}"))
                if v is None:
                    continue
                label = (read(f"{base}/{h}/temp{m.group(1)}_label") or "").strip()
                mx = num(read(f"{base}/{h}/temp{m.group(1)}_max"))
                key = name + ("/" + label if label else "")
                while key in out:
                    key += "'"
                out[key] = {"t": v / 1000.0, "max": mx / 1000.0 if mx else None}
        return out

    # -- Disk
    def disks(self, now):
        io = []
        for line in (read("/proc/diskstats") or "").splitlines():
            p = line.split()
            if len(p) < 10 or not os.path.exists("/sys/block/" + p[2]):
                continue
            if p[2].startswith(("loop", "ram", "zram", "dm-")):
                continue
            io.append({"dev": p[2],
                       "read": self._rate("dr" + p[2], int(p[5]) * 512, now),
                       "write": self._rate("dw" + p[2], int(p[9]) * 512, now)})
        fs, seen = [], set()
        for line in (read("/proc/mounts") or "").splitlines():
            p = line.split()
            if len(p) < 3 or not p[0].startswith("/dev/") or p[0] in seen:
                continue
            if p[0].startswith("/dev/loop") or p[2] in ("squashfs", "vfat"):
                continue
            seen.add(p[0])
            try:
                st = os.statvfs(p[1])
            except OSError:
                continue
            total = st.f_blocks * st.f_frsize
            if total:
                fs.append({"dev": p[0][5:], "mount": p[1], "total": total,
                           "used": total - st.f_bavail * st.f_frsize})
        return io, fs

    # -- network
    def net(self, now):
        out = []
        for line in (read("/proc/net/dev") or "").splitlines()[2:]:
            name, _, rest = line.partition(":")
            name, p = name.strip(), rest.split()
            if len(p) < 16 or name == "lo" or name.startswith(("veth", "docker", "br-", "virbr")):
                continue
            state = (read(f"/sys/class/net/{name}/operstate") or "?").strip()
            speed = num(read(f"/sys/class/net/{name}/speed"))
            out.append({"if": name, "state": state,
                        "speed": int(speed) if speed and speed > 0 else None,
                        "rx": self._rate("nr" + name, int(p[0]), now),
                        "tx": self._rate("nt" + name, int(p[8]), now),
                        "err": int(p[2]) + int(p[10]), "drop": int(p[3]) + int(p[11])})
            bad = out[-1]["err"] + out[-1]["drop"]   # counters since boot; flag only fresh increases
            old = self.neterr.get(name)
            self.neterr[name] = (bad, now if old and bad > old[0] else (old[1] if old else 0.0))
            out[-1]["err_new"] = now - self.neterr[name][1] < 60
        out.sort(key=lambda n: (n["state"] != "up", n["if"]))
        return out

    # -- processes
    def _docker_names(self, now):
        names, ts = self.docker
        if now - ts > 15:
            names = {}
            try:
                r = subprocess.run(["docker", "ps", "--no-trunc", "--format", "{{.ID}}\t{{.Names}}"],
                                   capture_output=True, text=True, timeout=3)
                for line in r.stdout.splitlines():
                    i, _, n = line.partition("\t")
                    names[i] = n
            except Exception:
                pass
            self.docker = (names, now)
        return names

    @staticmethod
    def _pretty(argv):
        if not argv:
            return "?"
        if " --" in argv[0]:                         # Chrome/Electron rewrite argv into one string
            argv = argv[0].split() + argv[1:]
        joined = " ".join(argv)
        if "vllm" in joined:
            model = None
            for i, a in enumerate(argv):
                if a == "serve" and i + 1 < len(argv) and not argv[i + 1].startswith("-"):
                    model = argv[i + 1]
                if a in ("--model", "--served-model-name") and i + 1 < len(argv):
                    model = model or argv[i + 1]
            return "vllm " + (model or "serve")
        a0 = os.path.basename(argv[0])
        if a0.startswith("python") and len(argv) > 2 and argv[1] == "-c":
            return a0 + " -c … " + " ".join(argv[3:6])
        if a0.startswith("python") and len(argv) > 1:
            if "-m" in argv[1:-1]:
                return a0 + " -m " + argv[argv.index("-m") + 1]
            script = next((a for a in argv[1:] if not a.startswith("-")), "")
            return (a0 + " " + os.path.basename(script)).strip()
        # other programs: name, their role (--type=...) and plain arguments, no option noise
        role = next((a[7:] for a in argv[1:] if a.startswith("--type=")), "")
        plain = []
        for a in argv[1:3]:
            if a.startswith("-"):
                break
            plain.append(a)
        return " ".join([a0] + plain) + (f" ({role})" if role else "")

    def procs(self, raw, now):
        merged = {}
        for p in raw:
            m = merged.setdefault(p["pid"], dict(p, gpu_mem=0))
            m["gpu_mem"] += p["gpu_mem"] or 0
            if p["type"] == "C":
                m["type"] = "C"
        dock, out, alive = None, [], {}
        for pid, p in merged.items():
            stat = read(f"/proc/{pid}/stat")
            if not stat:
                p.update(user="?", cpu=0.0, rss=0, name="(pid not visible)", container=None, argv=[])
                out.append(p)
                continue
            f = stat[stat.rfind(")") + 2:].split()
            ticks = int(f[11]) + int(f[12])
            old = self.pcpu.get(pid)
            alive[pid] = (ticks, now)
            p["cpu"] = 100.0 * (ticks - old[0]) / CLK_TCK / (now - old[1]) if old and now > old[1] else 0.0
            statm = (read(f"/proc/{pid}/statm") or "0 0").split()
            p["rss"] = int(statm[1]) * PAGE
            try:
                p["user"] = pwd.getpwuid(os.stat(f"/proc/{pid}").st_uid).pw_name
            except (KeyError, OSError):
                p["user"] = "?"
            argv = [a for a in (read(f"/proc/{pid}/cmdline") or "").split("\0") if a]
            p["argv"] = argv
            p["name"] = self._pretty(argv) if argv else stat[stat.find("(") + 1:stat.rfind(")")]
            p["name"] = re.sub(r"\s+", " ", "".join(c if c.isprintable() else " " for c in p["name"]))[:160]
            p["container"] = None
            m = re.search(r"docker[-/]([0-9a-f]{64})", read(f"/proc/{pid}/cgroup") or "")
            if m:
                if dock is None:
                    dock = self._docker_names(now)
                p["container"] = dock.get(m.group(1), m.group(1)[:12])
            out.append(p)
        self.pcpu = alive
        return out

    # -- vLLM
    def vllm(self, procs, now):
        urls = list(self.vllm_urls)
        for p in procs:
            argv = p.get("argv") or []
            if any("vllm" in a for a in argv):
                for i, a in enumerate(argv):
                    if a == "--port" and i + 1 < len(argv) and argv[i + 1].isdigit():
                        u = "http://127.0.0.1:" + argv[i + 1]
                        if u not in urls:
                            urls.append(u)
        out = []
        for url in urls:
            e = {"url": url, "ok": False}
            try:
                text = http_get(url.rstrip("/") + "/metrics", timeout=0.8)
            except Exception:
                out.append(e)
                continue
            tot, models = collections.defaultdict(float), set()
            for line in text.splitlines():
                if not line.startswith("vllm:"):
                    continue
                m = re.match(r"vllm:([A-Za-z0-9_]+)(\{[^}]*\})?\s+(\S+)", line)
                if not m:
                    continue
                try:
                    tot[m.group(1)] += float(m.group(3))
                except ValueError:
                    continue
                mm = re.search(r'model_name="([^"]*)"', m.group(2) or "")
                if mm:
                    models.add(mm.group(1))
            if not tot:
                out.append(e)
                continue

            def g(*names):
                for n in names:
                    if n in tot:
                        return tot[n]
                return None

            def r(*names):
                v = g(*names)
                return self._rate(url + names[0], v, now) if v is not None else 0.0

            def mean(base):
                s, c = g(base + "_sum"), g(base + "_count")
                if s is None or c is None:
                    return None
                old = self.vprev.get(url + base)
                self.vprev[url + base] = (s, c) + ((old[2],) if old else (None,))
                if old and c > old[1]:
                    val = (s - old[0]) / (c - old[1])
                    self.vprev[url + base] = (s, c, val)
                    return val
                return old[2] if old else (s / c if c else None)

            kv = g("kv_cache_usage_perc", "gpu_cache_usage_perc")
            e.update(ok=True, models=sorted(models),
                     running=g("num_requests_running") or 0, waiting=g("num_requests_waiting") or 0,
                     gen_tps=r("generation_tokens_total", "generation_tokens"),
                     prompt_tps=r("prompt_tokens_total", "prompt_tokens"),
                     req_rate=r("request_success_total", "request_success"),
                     kv=kv * 100.0 if kv is not None else None,
                     ttft=mean("time_to_first_token_seconds"),
                     e2e=mean("e2e_request_latency_seconds"))
            out.append(e)
        return out

    # -- alerts
    @staticmethod
    def alerts(s):
        a = []
        m = s["mem"]
        if m["total"]:
            free = 100.0 * m["avail"] / m["total"]
            if free < 8:
                a.append(("crit", f"memory almost full: only {free:.0f} % available"))
            elif free < 15:
                a.append(("warn", f"memory low: {free:.0f} % available"))
        if m["swap_used"] > 2**30:
            a.append(("warn", f"swap in use: {m['swap_used'] / 2**30:.1f} GiB"))
        if m["psi"] is not None and m["psi"] > 10:
            a.append(("warn", f"memory pressure (PSI some avg10) {m['psi']:.0f} %"))
        for i, g in enumerate(s["gpus"]):
            if g["temp"] is not None and g["temp"] >= 85:
                a.append(("crit" if g["temp"] >= 92 else "warn", f"GPU {i} hot: {g['temp']:.0f} °C"))
            if (g["util"] or 0) >= 80 and g["clock"] and g["clock"] < 1000:
                a.append(("warn", f"GPU {i} only {g['clock']:.0f} MHz under load - possibly throttled"))
        if s["cpu"].get("temp") and s["cpu"]["temp"] >= 90:
            a.append(("warn", f"CPU hot: {s['cpu']['temp']:.0f} °C"))
        for k, t in s["temps"].items():
            if k.startswith("nvme") and t["max"] and t["t"] >= t["max"]:
                a.append(("warn", f"NVMe hot: {t['t']:.0f} °C"))
        for f in s["fs"]:
            if f["used"] / f["total"] > 0.92:
                a.append(("warn", f"{f['mount']} {100 * f['used'] / f['total']:.0f} % full"))
        for v in s["vllm"]:
            if v["ok"] and v["waiting"] >= 1:
                a.append(("info", f"vLLM {urlparse(v['url']).port}: {v['waiting']:.0f} requests waiting"))
        return [{"level": l, "msg": t} for l, t in a]

    def sample(self):
        now = time.time()
        s = {"v": VERSION, "host": self.host, "ts": now,
             "kernel": os.uname().release, "arch": os.uname().machine,
             "uptime": num(read("/proc/uptime")) or 0}
        s["cpu"] = self.cpu(now)
        s["mem"] = self.mem()
        s["temps"] = self.temps()
        ct = [t["t"] for k, t in s["temps"].items()
              if k.startswith(("acpitz", "coretemp", "k10temp", "cpu", "soc"))]
        s["cpu"]["temp"] = max(ct) if ct else None
        gpus, raw, driver = [], [], "?"
        try:
            if self.nvml:
                gpus, raw, driver = self.nvml.sample()
            else:
                gpus, raw, driver = smi_sample()
                self.gpu_src = "nvidia-smi"
        except Exception as ex:
            s["gpu_error"] = str(ex)[:120]
        s["gpus"], s["driver"], s["gpu_src"] = gpus, driver, self.gpu_src
        procs = self.procs(raw, now)
        s["vllm"] = self.vllm(procs, now)
        for p in procs:
            p.pop("argv", None)
        s["procs"] = procs
        s["gpu_proc_mem"] = sum(p["gpu_mem"] for p in procs)
        s["unified"] = bool(gpus) and all(g["mem_total"] is None for g in gpus)
        s["disks"], s["fs"] = self.disks(now)
        s["net"] = self.net(now)
        s["alerts"] = self.alerts(s)
        utils = [g["util"] for g in gpus if g["util"] is not None]
        h = self.hist
        h["cpu"].append(round(s["cpu"]["util"], 1))
        h["mem"].append(round(100.0 * s["mem"]["used"] / max(1, s["mem"]["total"]), 1))
        h["gpu"].append(round(sum(utils) / len(utils), 1) if utils else 0)
        h["power"].append(round(sum(g["power"] or 0 for g in gpus), 1))
        h["tps"].append(round(sum(v.get("gen_tps", 0) for v in s["vllm"] if v["ok"]), 1))
        s["hist"] = {k: list(v)[-160:] for k, v in h.items()}
        return s

    def run(self):
        self.snap = self.sample()
        time.sleep(0.3)
        while not self.stop.is_set():
            t0 = time.time()
            try:
                self.snap = self.sample()
            except Exception as ex:                      # collector must never die
                if self.snap:
                    self.snap = dict(self.snap, collector_error=str(ex)[:160])
            if time.time() - self.saved > 60:
                self.save_hist()
            self.stop.wait(max(0.2, self.interval - (time.time() - t0)))


