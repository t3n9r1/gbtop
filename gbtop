def prometheus(s):
    L = [f'gbtop_cpu_util_percent {s["cpu"]["util"]:.2f}',
         f'gbtop_mem_total_bytes {s["mem"]["total"]}',
         f'gbtop_mem_available_bytes {s["mem"]["avail"]}',
         f'gbtop_swap_used_bytes {s["mem"]["swap_used"]}',
         f'gbtop_gpu_process_memory_bytes {s["gpu_proc_mem"]}']
    for i, g in enumerate(s["gpus"]):
        for key, name in (("util", "gpu_util_percent"), ("temp", "gpu_temp_celsius"),
                          ("power", "gpu_power_watts"), ("clock", "gpu_clock_mhz")):
            if g[key] is not None:
                L.append(f'gbtop_{name}{{gpu="{i}"}} {g[key]}')
    for v in s["vllm"]:
        if v["ok"]:
            lab = f'{{endpoint="{v["url"]}"}}'
            L += [f'gbtop_vllm_generation_tokens_per_second{lab} {v["gen_tps"]:.2f}',
                  f'gbtop_vllm_requests_running{lab} {v["running"]}',
                  f'gbtop_vllm_requests_waiting{lab} {v["waiting"]}']
    return "\n".join(L) + "\n"


def serve(col, bind, port, token):
    class H(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def do_GET(self):
            u = urlparse(self.path)
            if token:
                got = self.headers.get("Authorization", "")[7:] or parse_qs(u.query).get("token", [""])[0]
                if not hmac.compare_digest(got, token):
                    self.send_error(401)
                    return
            s = col.snap
            if u.path == "/api/snapshot" and s:
                body, ctype = json.dumps(s).encode(), "application/json"
            elif u.path == "/metrics" and s:
                body, ctype = prometheus(s).encode(), "text/plain; version=0.0.4"
            else:
                self.send_error(404)
                return
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

    srv = ThreadingHTTPServer((bind, port), H)
    srv.daemon_threads = True
    return srv


class Remote:
    """Fetches snapshots from a remote agent."""
    def __init__(self, spec, interval, stop):
        parts = spec.split()
        self.token = parts[1] if len(parts) > 1 else None
        hp = parts[0]
        if "://" not in hp:
            if ":" not in hp:
                hp += f":{DEFAULT_PORT}"
            hp = "http://" + hp
        self.url = hp.rstrip("/") + "/api/snapshot"
        self.name = self.addr = urlparse(hp).hostname
        self.snap, self.ok, self.err, self.lat, self.last = None, False, "connecting ...", None, 0
        self.interval, self.stop = interval, stop
        threading.Thread(target=self.run, daemon=True).start()

    def run(self):
        while not self.stop.is_set():
            t0 = time.time()
            try:
                self.snap = json.loads(http_get(self.url, timeout=2.5, token=self.token))
                self.name = f"{self.snap.get('host', '?')} ({self.addr})"
                self.lat, self.ok, self.err, self.last = (time.time() - t0) * 1000, True, "", time.time()
            except Exception as ex:
                self.ok, self.err = False, str(getattr(ex, "reason", ex))[:40]
            self.stop.wait(self.interval)


class SSHNode:
    """Agentless node: runs this very script on the remote host through ssh
    (source piped to 'python3 -') and reads one JSON snapshot per line."""
    def __init__(self, target, interval, stop, extra=""):
        self.target = self.name = target
        self.interval, self.stop = interval, stop
        self.snap, self.err, self.lat, self.last, self.proc = None, "connecting ...", None, 0.0, None
        self.cmd = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=6",
                    "-o", "ServerAliveInterval=5", "-o", "ServerAliveCountMax=2",
                    target, f"python3 -u - --emit -i {interval:g} {extra}"]
        threading.Thread(target=self.run, daemon=True).start()
        threading.Thread(target=self.ping, daemon=True).start()

    @property
    def ok(self):
        return self.snap is not None and time.time() - self.last < 3 * self.interval + 4

    def run(self):
        with open(os.path.abspath(__file__), "rb") as f:
            src = f.read()
        while not self.stop.is_set():
            try:
                p = self.proc = subprocess.Popen(self.cmd, stdin=subprocess.PIPE,
                                                 stdout=subprocess.PIPE, stderr=subprocess.PIPE)
                try:
                    p.stdin.write(src)
                    p.stdin.close()
                except OSError:
                    pass
                for line in p.stdout:
                    try:
                        snap = json.loads(line)
                    except ValueError:
                        continue                     # e.g. output of a remote shell profile
                    self.snap, self.last, self.err = snap, time.time(), ""
                    self.name = f"{snap.get('host', '?')} ({self.target})"
                msg = p.stderr.read().decode("utf-8", "replace").strip().splitlines()
                p.wait()
                self.err = (msg[-1] if msg else f"ssh exited with code {p.returncode}")[:70]
            except OSError as ex:
                self.err = str(ex)[:70]
            self.stop.wait(5)

    def ping(self):
        """Network latency = TCP connect time to the node's SSH port."""
        host, port = self.target.split("@")[-1], 22
        try:
            cfg = subprocess.run(["ssh", "-G", self.target], capture_output=True, text=True, timeout=5).stdout
            for line in cfg.splitlines():
                k, _, v = line.partition(" ")
                if k == "hostname":
                    host = v.strip()
                elif k == "port":
                    port = int(v)
        except Exception:
            pass
        while not self.stop.is_set():
            t0 = time.time()
            try:
                socket.create_connection((host, port), timeout=2).close()
                self.lat = (time.time() - t0) * 1000
            except OSError:
                self.lat = None
            self.stop.wait(5)

    def close(self):
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()


class Local:
    def __init__(self, col):
        self.col, self.name, self.ok, self.err, self.lat = col, col.host, True, "", 0.0

    @property
    def snap(self):
        return self.col.snap


